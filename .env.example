# ═══════════════════════════════════════════════════════════
# Meu Acervo 3D - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha se necessário
# ═══════════════════════════════════════════════════════════

# Freesound (opcional - https://freesound.org/apiv2/apply/)
# Sem essa key, o site continua funcionando com a curadoria local.
FREESOUND_API_KEY=

# Pixabay (opcional - https://pixabay.com/api/docs/)
# Sem essa key, o site continua funcionando com a curadoria local.
PIXABAY_API_KEY=

# Porta do servidor local (padrão: 3000)
PORT=3000
